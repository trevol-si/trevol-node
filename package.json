{
	"name": "@trevol/sdk",
	"version": "0.1.0",
	"description": "SDK de Node.js/TypeScript para la API de Trevol: facturación electrónica ante la DIAN (Colombia).",
	"keywords": ["trevol", "dian", "factura electrónica", "colombia", "nómina electrónica", "sdk"],
	"homepage": "https://platform.trevol.si/docs",
	"repository": { "type": "git", "url": "git+https://github.com/trevol/trevol-node.git" },
	"bugs": { "url": "https://github.com/trevol/trevol-node/issues" },
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "GENERADO.md"],
	"sideEffects": false,
	"engines": { "node": ">=22.12" },
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:prism": "vitest run pruebas/prism pruebas/fragmentos",
		"test:todo": "npm run typecheck && npm test",
		"humo": "npm run build && node pruebas/humo/humo.mjs"
	},
	"dependencies": {
		"standardwebhooks": "1.1.1"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
